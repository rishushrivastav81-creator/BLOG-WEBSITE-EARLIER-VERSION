# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL primary connection string
DATABASE_URL="postgresql+asyncpg://meridian_user:YOUR_DB_PASSWORD@localhost:5432/meridian_db"

# PGBOUNCER_URL: Pooled database connection string
PGBOUNCER_URL="postgresql+asyncpg://meridian_user:YOUR_DB_PASSWORD@localhost:6432/meridian_db"

# REDIS_URL: Distributed cache and rate limiting
REDIS_URL="redis://localhost:6379/0"

# SANDBOX_WORKER_URL: Isolated execution worker (gVisor microVM service)
SANDBOX_WORKER_URL="http://localhost:50051"

# JWT_SECRET_KEY: Used for signing member session tokens
JWT_SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# ADMIN_BOOTSTRAP_TOKEN: One-time token used to initialize superadmin credentials via CLI
ADMIN_BOOTSTRAP_TOKEN="REPLACE_WITH_TEMPORARY_INITIALIZATION_TOKEN"
